{
  "name": "@kaveraa/keycloak-sanctum-vue",
  "version": "1.0.0",
  "description": "Vue 3 client for Keycloak login (SSO) with a Laravel API: Sanctum token, user, roles, router guard, authenticated fetch and inactivity logout.",
  "keywords": [
    "vue",
    "vue3",
    "keycloak",
    "sanctum",
    "laravel",
    "sso",
    "oidc",
    "authentication",
    "vue-router"
  ],
  "homepage": "https://github.com/kaveraa/keycloak-sanctum-vue#readme",
  "bugs": {
    "url": "https://github.com/kaveraa/keycloak-sanctum-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaveraa/keycloak-sanctum-vue.git"
  },
  "license": "MIT",
  "author": "Augustin Kavera (https://github.com/kaveraa)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vue-router": "^4.2.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
